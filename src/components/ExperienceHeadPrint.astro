---
import type { i18n } from 'i18next';
import { formatDate } from '../utils/dateFormat';

export interface Props {
  exp: any;
  t: i18n['t'];
}

const { exp, t } = Astro.props;
const toDate =
  !exp.to || exp.to.toLowerCase() === 'today'
    ? t('currently')
    : formatDate(exp.to);
---

<div class=`experience-head ${exp.profile}`>
  <div class="position">{t(exp.position)}</div>
  <div class="date">
    {formatDate(exp.from)} – {toDate}
  </div>
  <div class="company">
    {exp.name}
    {exp.nameNote && ` (${exp.nameNote})`}
  </div>
  <div class="location">{t(exp.location)}</div>
</div>
